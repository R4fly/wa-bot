{
  "name": "@baehaqirafly3/bot-wa-testing",
  "version": "0.2.0-next.1",
  "description": "Testing utilities for bots built with @baehaqirafly3/bot-wa. Vitest compatible.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@baehaqirafly3/bot-wa": "0.2.0-next.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}