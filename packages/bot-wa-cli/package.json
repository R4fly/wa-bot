  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@baehaqirafly3/bot-wa": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
