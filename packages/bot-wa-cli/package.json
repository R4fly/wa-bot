{
  "name": "@baehaqirafly3/bot-wa-cli",
  "version": "0.1.0",
  "description": "Command line tool for bots built with @baehaqirafly3/bot-wa.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bot-wa": "./dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
