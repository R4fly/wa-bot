{
  "name": "@baehaqirafly3/bot-wa-cli",
  "version": "0.2.0-next.1",
  "description": "Command line companion for @baehaqirafly3/bot-wa",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./scaffold": {
      "import": "./dist/scaffold.js",
      "require": "./dist/scaffold.cjs",
      "types": "./dist/scaffold.d.ts"
    }
  },
  "bin": {
    "bot-wa": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@baehaqirafly3/bot-wa": "workspace:*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5"
  }
}