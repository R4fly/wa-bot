{
  "name": "@baehaqirafly3/bot-wa-cli",
  "version": "0.2.0-next.0",
  "description": "Command line tool for bots built with @baehaqirafly3/bot-wa.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bot-wa": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./scaffold": {
      "types": "./dist/scaffold.d.ts",
      "import": "./dist/scaffold.js",
      "require": "./dist/scaffold.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@baehaqirafly3/bot-wa": "0.2.0-next.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
