{
  "name": "baehaqirafly3-wa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gate": "npm run lint --workspaces --if-present && npm run typecheck --workspaces --if-present && npm run test --workspaces --if-present && npm run build --workspaces --if-present && npm audit --audit-level=high --omit=dev",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "audit": "npm audit --audit-level=high --omit=dev",
    "bench:boot": "node --input-type=module -e \"const t0 = Date.now(); await import('./packages/bot-wa/dist/index.js'); console.log('boot ms', Date.now() - t0);\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.1.1",
    "eslint": "^9.10.0",
    "eslint-plugin-import": "^2.30.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "turbo": "^2.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.1"
  }
}